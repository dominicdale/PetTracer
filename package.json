    "db:local": "wrangler d1 migrations apply pettracer --local"
  },
  "dependencies": { "leaflet": "1.9.4", "jose": "6.1.3" },
  "devDependencies": { "vite": "7.3.1", "wrangler": "4.76.0" }
}
